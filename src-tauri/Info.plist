<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- UI は日本語だけ。OS が出す文言（メニューに足される項目・ダイアログ・WebView の右クリック）も日本語にする（ADR-77） -->
	<key>CFBundleDevelopmentRegion</key>
	<string>ja</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ja</string>
	</array>
	<!-- 解放した 1 MiB 未満の確保を libmalloc がすぐ OS へ返す（音声のチャンクの抱え込みをなくす。man にない設定。ADR-183） -->
	<key>LSEnvironment</key>
	<dict>
		<key>MallocSpaceEfficient</key>
		<string>1</string>
	</dict>
</dict>
</plist>
