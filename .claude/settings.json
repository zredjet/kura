{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm run *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm tauri dev)",
      "Bash(pnpm tauri info)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo run -p kura-devtools *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(which *)",
      "Bash(yt-dlp --version)",
      "Bash(gallery-dl --version)",
      "Bash(ffprobe *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(pnpm add *)",
      "Bash(cargo add *)",
      "Bash(brew *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  }
}
