+const char *kura_setup_template(const void *setup, int *coupling_restriction,
+                                long *rate_min, long *rate_max, int *mappings){
+  int i;
+  for(i=0;kura_templates[i].t;i++){
+    if((const void *)kura_templates[i].t==setup){
+      if(coupling_restriction)*coupling_restriction=kura_templates[i].t->coupling_restriction;
+      if(rate_min)*rate_min=kura_templates[i].t->samplerate_min_restriction;
+      if(rate_max)*rate_max=kura_templates[i].t->samplerate_max_restriction;
+      if(mappings)*mappings=kura_templates[i].t->mappings;
+      return kura_templates[i].name;
+    }
+  }
+  return "?";
 }
